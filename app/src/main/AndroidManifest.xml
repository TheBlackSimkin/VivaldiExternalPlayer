<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Foreground service used only for user-requested BG preparation.
      It resolves technical stream metadata; it never owns playback/ExoPlayer.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TabbedPlayerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="External Video Player"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VivaldiExternalPlayer"
        android:usesCleartextTraffic="false">

        <!-- AndroidX app-language persistence for API 24-32. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider android:name=".BrowserAssistEnhancerProvider" android:authorities="${applicationId}.browserassist" android:exported="false" />
        <provider android:name=".PendingBrowserTabBridgeProvider" android:authorities="${applicationId}.pendingtabbridge" android:exported="false" />
        <provider android:name=".PlayerRecoveryProvider" android:authorities="${applicationId}.playerrecovery" android:exported="false" />
        <provider android:name=".ForegroundPlaybackGuardProvider" android:authorities="${applicationId}.foregroundguard" android:exported="false" />

        <activity android:name=".PlayerActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".BrowserResolverActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <!--
          Current normal BG preparation owner.

          Starting with the post-#227 architecture, this foreground service owns
          each resolver session directly. The session creates an app-private
          virtual display and a Presentation/WebView on that display. No normal
          BG preparation Activity is launched on the physical/default display.
          The service/session never creates PlayerActivity or ExoPlayer.
        -->
        <service
            android:name=".BackgroundPreparationKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          Historical default-display preparation Activity retained for source
          compatibility/diagnostics only. Normal BG shares no longer launch it.

          #212 proved an Activity cannot be launched as the first app Activity on
          this private virtual display without privileged embedding rights.
          #225/#227 then proved a transparent preparation Activity on display 0
          can still disturb Vivaldi. The successor architecture reuses only the
          private-display primitive and places a non-Activity Presentation there.
        -->
        <activity
            android:name=".BackgroundVirtualPreparationActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <!-- Legacy non-exported preparer for older explicit paths only. -->
        <activity
            android:name=".BackgroundPreparationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="${applicationId}.backgroundprepare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <!--
          Exported "BG - External Player" chooser target.

          This Activity only validates the URL, creates the persistent tab and
          starts the foreground service with the URL/tab/session token. It then
          removes its own short share task. There is no follow-up preparation
          Activity on display 0; service-owned private-display work continues
          independently.
        -->
        <activity
            android:name=".BackgroundShareActivityV2"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/add_to_external_player"
            android:launchMode="standard"
            android:taskAffinity="${applicationId}.backgroundshare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Old #192 implementation is kept only as source history/reference. -->
        <activity
            android:name=".BackgroundShareActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <activity
            android:name=".ForegroundShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:noHistory="true"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="10">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
