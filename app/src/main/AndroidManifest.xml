<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The BG share host now gets a short foreground-process lease while it owns
      direct/WebView preparation. This is NOT playback: the service never creates
      ExoPlayer and is declared only as dataSync because it keeps user-requested
      network preparation alive while Vivaldi remains in front.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TabbedPlayerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="External Video Player"
        android:supportsRtl="true"
        android:theme="@style/Theme.VivaldiExternalPlayer"
        android:usesCleartextTraffic="false">

        <provider android:name=".BrowserAssistEnhancerProvider" android:authorities="${applicationId}.browserassist" android:exported="false" />
        <provider android:name=".PendingBrowserTabBridgeProvider" android:authorities="${applicationId}.pendingtabbridge" android:exported="false" />
        <provider android:name=".PlayerRecoveryProvider" android:authorities="${applicationId}.playerrecovery" android:exported="false" />
        <provider android:name=".ForegroundPlaybackGuardProvider" android:authorities="${applicationId}.foregroundguard" android:exported="false" />

        <activity android:name=".PlayerActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".BrowserResolverActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <!--
          Short-lived keep-alive for a user-requested BG preparation session.
          The Activity still owns yt-dlp/WebView discovery; this service only
          protects process lifetime and records technical lifecycle state.
          It never owns PlayerActivity, Media3 or ExoPlayer.
        -->
        <service
            android:name=".BackgroundPreparationKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          This non-exported preparer remains for foreground retry/preload and
          process-recovery paths. The normal BG share path no longer needs to
          launch this second Activity before it can start doing work.
        -->
        <activity
            android:name=".BackgroundPreparationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="${applicationId}.backgroundprepare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <!--
          #192 proved that a self-owned share Activity starts preparation without
          requiring a dashboard/tab click, but PH device QA also proved that its
          automatic browser copy was not equivalent to the successful visible
          Browser Step.

          BackgroundShareActivityV2 keeps the self-owned document-task model and
          adds a bounded direct budget plus browser-like hidden discovery (normal
          layout + Service Worker observation). The Activity remains excluded from
          Recents and moves behind Vivaldi; it never owns ExoPlayer/playback.

          The application lifecycle now starts the short foreground preparation
          lease before this Activity's posted moveTaskToBack() runs. This prevents
          Android from silently demoting the process into the old recovery path.

          Do not add android:noHistory: Android must be allowed to keep this
          explicit share host alive while its preparation is in progress.
        -->
        <activity
            android:name=".BackgroundShareActivityV2"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/add_to_external_player"
            android:launchMode="standard"
            android:taskAffinity="${applicationId}.backgroundshare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Old #192 implementation is kept only as source history/reference. -->
        <activity
            android:name=".BackgroundShareActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <activity
            android:name=".ForegroundShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:noHistory="true"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="10">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
