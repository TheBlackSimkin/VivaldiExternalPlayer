<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Short foreground-process lease for user-requested BG preparation.
      The service does not own playback or ExoPlayer.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TabbedPlayerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="External Video Player"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VivaldiExternalPlayer"
        android:usesCleartextTraffic="false">

        <!--
          AndroidX app-language persistence for API 24-32. Android 13+ also sees
          the same supported languages through android:localeConfig above.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider android:name=".BrowserAssistEnhancerProvider" android:authorities="${applicationId}.browserassist" android:exported="false" />
        <provider android:name=".PendingBrowserTabBridgeProvider" android:authorities="${applicationId}.pendingtabbridge" android:exported="false" />
        <provider android:name=".PlayerRecoveryProvider" android:authorities="${applicationId}.playerrecovery" android:exported="false" />
        <provider android:name=".ForegroundPlaybackGuardProvider" android:authorities="${applicationId}.foregroundguard" android:exported="false" />

        <activity android:name=".PlayerActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".BrowserResolverActivity" android:configChanges="keyboardHidden|orientation|screenSize" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <!--
          Short-lived foreground process lease. It only protects process lifetime
          while one or more explicit BG shares are preparing. The service never
          creates Media3/ExoPlayer or background playback.
        -->
        <service
            android:name=".BackgroundPreparationKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          Current normal BG preparation host.

          The class name still contains "Virtual" for source-history continuity,
          but build #212 device QA proved that Android 13 refuses the first normal
          third-party Activity launch onto an untrusted private virtual display.
          The normal path therefore launches this Activity on the DEFAULT display
          in the same excluded task. The application lifecycle callback keeps the
          window fully transparent, NOT_TOUCHABLE, NOT_FOCUSABLE and
          NOT_TOUCH_MODAL while keeping the Activity top/RESUMED. This deliberately
          separates the WebView lifecycle from user-input focus: #205 proved a
          STOPPED host is destroyed on this phone, while #225 proved alpha=0 alone
          still left Vivaldi unresponsive for about seven seconds.
        -->
        <activity
            android:name=".BackgroundVirtualPreparationActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="standard"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <!--
          Legacy non-exported preparer remains only for explicit retry/preload
          and older recovery paths. Normal BG shares no longer use it.
        -->
        <activity
            android:name=".BackgroundPreparationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="${applicationId}.backgroundprepare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <!--
          Exported BG chooser target. This Activity is a short share-time handoff:
          create tab -> start foreground lease -> launch the transparent RESUMED
          preparation Activity in the same excluded task -> finish the handoff.

          It deliberately does NOT move the task behind Vivaldi and does NOT use
          ActivityOptions.launchDisplayId. The preparer must remain RESUMED until
          it reaches READY/ERROR/NEEDS_ATTENTION, but its window must not own
          physical-display input focus.
        -->
        <activity
            android:name=".BackgroundShareActivityV2"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/add_to_external_player"
            android:launchMode="standard"
            android:taskAffinity="${applicationId}.backgroundshare"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="100">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Old #192 implementation is kept only as source history/reference. -->
        <activity
            android:name=".BackgroundShareActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent" />

        <activity
            android:name=".ForegroundShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:noHistory="true"
            android:theme="@style/Theme.VivaldiExternalPlayer.Transparent">
            <intent-filter android:order="10">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/open_in_external_player"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
