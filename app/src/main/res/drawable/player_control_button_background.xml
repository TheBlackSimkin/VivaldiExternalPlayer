<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact player-only control surface.

    It intentionally stays translucent and mostly charcoal so it does not compete
    with the video. The purple outline connects the control to the launcher/logo
    identity without turning the entire button into a bright block.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_player_control_surface" />
    <corners android:radius="11dp" />
    <stroke android:width="1dp" android:color="@color/app_accent_outline" />
</shape>
