<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_intro"
        android:textSize="17sp" />

    <Button
        android:id="@+id/open_tabs_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_saved_tabs"
        android:visibility="gone" />

    <EditText
        android:id="@+id/url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/url_hint"
        android:inputType="textUri" />

    <Button
        android:id="@+id/resolve_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/resolve_and_play" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <Button
        android:id="@+id/browser_resolve_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_browser_assisted_resolver"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textIsSelectable="true" />

    <Button
        android:id="@+id/settings_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings" />

    <Button
        android:id="@+id/about_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about" />
</LinearLayout>
