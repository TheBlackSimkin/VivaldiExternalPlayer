<?xml version="1.0" encoding="utf-8"?>

<!--
    Media3 player screen.

    The main video surface fills the screen. Small project-specific controls are
    overlaid at the top so they remain separate from Media3's standard transport
    controls at the bottom.

    This version includes:
    - the normal Media3 video/controller surface;
    - a Diagnostics button for technical playback information;
    - a Quality button for direct and adaptive streams;
    - an error/status banner;
    - the existing seek-thumbnail preview.

    Keep this file as plain UTF-8 XML. There must be no Markdown code fences,
    text, spaces, or other characters before the XML declaration above.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        Media3's PlayerView contains:
        - the video rendering surface;
        - play/pause;
        - seek bar;
        - standard playback controls.

        GesturePlayerView is our project subclass which also handles the
        left/right double-tap seeking behavior.
    -->
    <com.example.vivaldiplayer.GesturePlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_shuffle_button="false"
        app:use_controller="true" />

    <!--
        Development diagnostics button.

        This remains available even before an error occurs, because it can show
        which resolver/source Media3 received. If playback fails, PlayerActivity
        changes the label to "Playback error" / "Error de reproducción".
    -->
    <Button
        android:id="@+id/diagnostics_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#AA303030"
        android:minWidth="0dp"
        android:minHeight="40dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/player_diagnostics"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

    <!--
        Quality control.

        For yt-dlp/direct sources, changing quality re-runs the resolver.

        For browser-assisted adaptive HLS/DASH sources, PlayerActivity reads the
        available Media3 video tracks and changes the track selection directly.
    -->
    <Button
        android:id="@+id/quality_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="#AA303030"
        android:minHeight="40dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/quality_auto"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

    <!--
        Hidden during normal playback.

        PlayerActivity makes this visible after a real Media3 error so a failed
        stream no longer looks like an unexplained black player.
    -->
    <TextView
        android:id="@+id/playback_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:background="#CC202020"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
        Thumbnail preview displayed while the user drags Media3's seek bar.

        The image is decoded locally from the selected stream by FrameExtractor.
        It is not uploaded or semantically analyzed.
    -->
    <LinearLayout
        android:id="@+id/preview_container"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:background="@drawable/preview_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/preview_image"
            android:layout_width="168dp"
            android:layout_height="94dp"
            android:contentDescription="@string/seek_preview"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
