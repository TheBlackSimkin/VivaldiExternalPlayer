<?xml version="1.0" encoding="utf-8"?>
<!--
    Media3 player screen.

    The proven PlayerActivity logic still owns Quality and Diagnostics. Their
    legacy buttons remain in the view hierarchy so existing click handlers are
    untouched, but are hidden; PlayerChromeProvider exposes those same actions in
    one compact gear menu beside the square tab-count button.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.example.vivaldiplayer.GesturePlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:show_shuffle_button="false"
        app:use_controller="true" />

    <Button
        android:id="@+id/diagnostics_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_diagnostics"
        android:visibility="gone" />

    <Button
        android:id="@+id/quality_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quality_auto"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playback_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="12dp"
        android:background="#CC202020"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/preview_container"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="86dp"
        android:background="@drawable/preview_background"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/preview_image"
            android:layout_width="168dp"
            android:layout_height="94dp"
            android:contentDescription="@string/seek_preview"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/preview_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
