<?xml version="1.0" encoding="utf-8"?>

<!--
    Browser-assisted resolver.

    The WebView is intentionally visible: the user interacts with the page
    normally and starts playback. The app only observes media URLs which the
    page/browser actually requests or exposes; it does not replace responses.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#202020"
        android:padding="10dp"
        android:text="@string/browser_resolver_intro"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

    <!-- Horizontal page-load progress supplied by WebChromeClient. -->
    <ProgressBar
        android:id="@+id/browser_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0" />

    <!-- Status is selectable so debugging information can be copied if needed. -->
    <TextView
        android:id="@+id/browser_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#202020"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <!-- Appears only after at least one plausible transferable media URL is found. -->
    <Button
        android:id="@+id/play_detected_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/browser_no_stream_button"
        android:textAllCaps="false"
        android:visibility="gone" />

    <WebView
        android:id="@+id/browser_web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
